{
  "$comment": "Machine-readable rules shared by scripts/git-checkpoint.py (ignore) and scripts/comment-lint-hook.py (keep, junk). Regexes are matched case-insensitively against the comment body with the comment marker stripped. Junk here is the high-precision subset of references/antislop.md; keep is the regex form of references/keep-list.md.",
  "ignore": {
    "dirs": [
      ".git",
      "node_modules",
      "dist",
      "build",
      "vendor",
      "__snapshots__"
    ],
    "globs": [
      "*.min.*",
      "*.map",
      "*.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "go.sum",
      "CHANGELOG*"
    ],
    "generated_markers": [
      "Code generated",
      "@generated",
      "DO NOT EDIT"
    ]
  },
  "comment_syntax": {
    "//": [
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".go",
      ".rs",
      ".java",
      ".kt",
      ".kts",
      ".swift",
      ".c",
      ".h",
      ".cc",
      ".cpp",
      ".hpp",
      ".cs",
      ".php",
      ".scala",
      ".dart",
      ".scss",
      ".less",
      ".vue",
      ".svelte"
    ],
    "#": [
      ".py",
      ".sh",
      ".bash",
      ".zsh",
      ".rb",
      ".yaml",
      ".yml",
      ".toml",
      ".r",
      ".pl",
      ".ex",
      ".exs",
      ".tf"
    ],
    "--": [
      ".sql",
      ".lua",
      ".hs"
    ]
  },
  "keep": [
    {
      "id": "lint-directive",
      "regex": "eslint-|@ts-(expect-error|ignore|nocheck|check)|biome-ignore|prettier-ignore|stylelint-|\\bnoqa\\b|type:\\s*ignore|pyright:|mypy:|pylint:|fmt:\\s*(off|on|skip)|isort:|\\bnolint\\b|NOSONAR|rubocop:|swiftlint:|@phpstan-|markdownlint-"
    },
    {
      "id": "build-pragma",
      "regex": "^!|-\\*-.*-\\*-|^go:|^\\+build\\b|webpack[A-Z]\\w*\\s*:|@vite-ignore|@__PURE__|@jsx|<reference\\s|^@flow\\b|^#?(end)?region\\b|^language="
    },
    {
      "id": "coverage",
      "regex": "(istanbul|c8|v8)\\s+ignore|pragma:\\s*no\\s*cover|coverage:ignore"
    },
    {
      "id": "generated",
      "regex": "code generated|@generated|do not edit"
    },
    {
      "id": "doc-tag",
      "regex": "@(deprecated|internal|public|alpha|beta|swagger|openapi|route|param\\s*\\{|type\\s*\\{|returns?\\s*\\{)"
    },
    {
      "id": "legal",
      "regex": "spdx-license-identifier|copyright|\\(c\\)\\s*\\d{4}|licen[cs]ed? under"
    }
  ],
  "junk": [
    {
      "id": "decorative-separator",
      "label": "decorative separator",
      "regex": "^[=\\-*#~_+/]{4,}|^[=\\-*#~]{3,}.*[=\\-*#~]{3,}$"
    },
    {
      "id": "workflow-narration",
      "label": "step-by-step narration",
      "regex": "^(step|bước)\\s*\\d+\\b"
    },
    {
      "id": "end-marker",
      "label": "end marker",
      "regex": "^end(\\s+of)?\\s+(if|else|for|foreach|while|loop|switch|try|catch|function|func|def|method|class|block|component)\\b"
    },
    {
      "id": "change-log",
      "label": "change-log about the edit",
      "regex": "^(updated|added|changed|modified|refactored|replaced|removed)\\s+(to|the|this|per|new|logic|code|function|method)\\b|^fixed?:\\s|\\b(as requested|per (your|the user'?s?) request)\\b"
    },
    {
      "id": "placeholder",
      "label": "placeholder or disclaimer",
      "regex": "\\bin a (real|production)[- ](app|application|implementation|project|world|scenario|system)\\b|\\breplace (this )?with (your|the|real|actual)\\s+(own\\s+)?(logic|implementation|code|api|data|key)\\b|\\bthis is a (simplified|simple|basic|placeholder|mock|dummy) (implementation|version|example)\\b"
    },
    {
      "id": "empty-label",
      "label": "empty label",
      "regex": "^(main|core|business) logic\\W*$|^helpers?( functions?)?\\W*$|^(entry point|error handling|imports?|variables?|constants?|types?|exports?|initiali[sz]ation|setup|utils?|utilities)\\W*$|^(note|important):\\s*(this is important|please read)\\W*$"
    },
    {
      "id": "vague-todo",
      "label": "vague TODO",
      "regex": "^(todo|fixme)\\b[\\s:\\-]*((maybe|perhaps|possibly|probably|should|could|might|we should|need to)\\s+)?(improve|optimi[sz]e|refactor|clean ?up|add more|fix|revisit|handle)(\\s+(this|it|that|later|validation|error handling|errors|edge cases|performance))*(\\s+(later|someday|eventually|in the future))?\\W*$"
    },
    {
      "id": "doc-tag-echo",
      "label": "doc tag that only restates the signature",
      "regex": "^@param\\s+\\w+\\s*-?\\s*(the|a|an)\\s+(\\w+\\s+)?(number|string|value|object|array|boolean|parameter|argument|input|item|list|callback|function|options?|props|data)\\W*$|^@returns?\\s+(the\\s+)?(result|value|output|\\w+)(\\s+of\\s+(the\\s+)?\\w+(\\s+and\\s+\\w+)?)?\\W*$"
    },
    {
      "id": "decorative-emoji",
      "label": "decorative emoji",
      "regex": "^(✅|🚀|✨|🎯|📝|⚡|🔥|💡|🔧|📦|🧹|🛠|🔒|📌)"
    }
  ],
  "echo": {
    "$comment": "scripts/comment_echo.py: a comment of at most max_words words with no why-signal is flagged when at least min_overlap of its content words (not stopwords, not neutral) appear in the code it sits on or above. A comment made only of neutral and stop words (\"Return the JSX\") is flagged too.",
    "max_words": 10,
    "min_overlap": 0.5,
    "why_regex": "\\b(because|since|so that|otherwise|unless|due to|in order|to (avoid|prevent|keep|ensure|support|match|satisfy|work around)|workaround|hack|note|must|never|always|only (if|when)|requires?|required|cannot|can't|don't|do not|won't|avoid|prevent|ensure|instead|why|bug|issue|see|todo|fixme|xxx|https?://|vì|để|tránh|phải|nếu|không|bởi|lưu ý)\\b",
    "neutral_words": [
      "add",
      "append",
      "assign",
      "build",
      "calculate",
      "call",
      "check",
      "compute",
      "convert",
      "create",
      "declare",
      "define",
      "display",
      "export",
      "fetch",
      "get",
      "handle",
      "import",
      "init",
      "initialize",
      "initialise",
      "iterate",
      "loop",
      "make",
      "merge",
      "parse",
      "process",
      "render",
      "return",
      "save",
      "set",
      "show",
      "store",
      "take",
      "update",
      "use",
      "accept",
      "argument",
      "arg",
      "array",
      "boolean",
      "class",
      "component",
      "const",
      "constant",
      "element",
      "field",
      "function",
      "html",
      "input",
      "interface",
      "jsx",
      "list",
      "method",
      "module",
      "number",
      "object",
      "optional",
      "output",
      "param",
      "parameter",
      "prop",
      "property",
      "string",
      "type",
      "utility",
      "value",
      "variable"
    ],
    "stopwords": [
      "a",
      "an",
      "the",
      "this",
      "that",
      "these",
      "those",
      "it",
      "its",
      "is",
      "are",
      "be",
      "here",
      "there",
      "of",
      "to",
      "in",
      "on",
      "at",
      "by",
      "for",
      "from",
      "with",
      "into",
      "as",
      "and",
      "or",
      "then",
      "new",
      "each",
      "every",
      "all",
      "through",
      "over",
      "together",
      "our",
      "we",
      "two",
      "one",
      "first",
      "second",
      "next"
    ]
  }
}
