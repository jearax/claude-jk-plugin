{
  "$comment": "Scope rules for scripts/list-changed-files.py: paths and generated files it never returns.",
  "ignore": {
    "dirs": [
      ".git",
      "node_modules",
      "dist",
      "build",
      "vendor",
      "__snapshots__"
    ],
    "globs": [
      "*.min.*",
      "*.map",
      "*.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "go.sum",
      "CHANGELOG*"
    ],
    "generated_markers": [
      "Code generated",
      "@generated",
      "DO NOT EDIT"
    ]
  }
}
